# Assistant chat (see README). Never commit real values.
# Server-only (Vercel env vars, not exposed to the browser):
ASSISTANT_SECRET=            # same value as n8n credential "Header Auth - Portfolio Assistant"
TURNSTILE_SECRET_KEY=        # Cloudflare Turnstile secret key
# ASSISTANT_WEBHOOK_URL=     # optional; defaults to https://assistant.adautoteam.top/webhook/assistant-chat
# Public (inlined at build, so redeploy after changing):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ASSISTANT_ENABLED=false   # "true" swaps the Fix My Bottleneck pill for the chat widget
# NEXT_PUBLIC_ASSISTANT_PRIVACY_URL=  # optional link shown under the chat box
